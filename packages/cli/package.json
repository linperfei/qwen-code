{
  "name": "@qwen-code/cli",
  "version": "0.15.0",
  "description": "Tiny Agent - Minimal AI Coding Agent CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linperfei/qwen-code.git"
  },
  "type": "module",
  "main": "dist/src/tiny-agent.js",
  "types": "dist/src/tiny-agent.d.ts",
  "bin": {
    "tiny-agent": "dist/src/tiny-agent.js",
    "qwen-agent": "dist/src/simple-agent.js"
  },
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/tiny-agent.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@qwen-code/llm": "file:../llm",
    "@qwen-code/qwen-code-core": "file:../core",
    "glob": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
