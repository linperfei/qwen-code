{
  "name": "@qwen-code/cli",
  "version": "0.15.0",
  "description": "Qwen Code CLI - Minimal AI Agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linperfei/qwen-code.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qwen": "dist/index.js",
    "qwen-agent": "dist/src/simple-agent.js"
  },
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
