{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "composite": true,
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@lydell/node-pty": ["../../node_modules/@lydell/node-pty/node-pty.d.ts"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.json"],
  "exclude": [
    "node_modules",
    "dist",
    "src/extension/github.test.ts",
    "src/lsp/LspConfigLoader.test.ts",
    "src/services/sessionService.test.ts",
    "src/utils/pathReader.test.ts"
  ]
}
